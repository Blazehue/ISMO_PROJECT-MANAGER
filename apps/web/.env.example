# Base URL for API calls. Leave as /api: Vite proxies it to the API in development
# and vercel.json rewrites it to the deployed API in production, so the
# refresh-token cookie stays first-party.
VITE_API_URL=/api

# Development only: where the Vite dev server proxies /api (default http://localhost:4000)
# VITE_DEV_API_PROXY=https://your-api.onrender.com

# Optional: link to the Android APK (EAS build URL). Shows a "Download for Android" button on the landing page.
# VITE_APK_URL=https://expo.dev/artifacts/eas/....apk
