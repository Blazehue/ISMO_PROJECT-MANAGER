# Runtime
NODE_ENV=development
PORT=4000

# PostgreSQL connection string (Neon, docker-compose, or `pnpm db:local`)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ismo

# Secret for signing access tokens: at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Token lifetimes
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of browser origins allowed by CORS (the web app)
CORS_ORIGINS=http://localhost:5173

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Number of reverse proxies in front of the API (Render/Vercel = 1). Needed so
# rate limiting sees the real client IP instead of the proxy's.
TRUST_PROXY=1
