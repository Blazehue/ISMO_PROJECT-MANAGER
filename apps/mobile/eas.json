{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "corepack": true
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ismo-api-j4b7.onrender.com/api"
      },
      "corepack": true
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "corepack": true
    }
  }
}
